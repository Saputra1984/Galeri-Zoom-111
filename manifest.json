{
  "name": "Galeri Zoom Extreme",
  "short_name": "Galeri Zoom",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#00e5ff",
  "icons": [
    { "src": "./icon-galeri-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "media", "accept": ["image/*", "video/*"] }
      ]
    }
  }
}
